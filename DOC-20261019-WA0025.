@charset "utf-8";

:root { --primary-color: #1b3d6d; --green-color: #178a48; --text-dark: #222; --text-grey: #555; --bg-light: #f4f6f9; }

body { font-family: Tajawal, sans-serif; margin: 0px; padding: 0px; background-color: var(--bg-light); color: var(--text-dark); overflow-x: hidden; }

* { box-sizing: border-box; }

.header { background: rgb(255, 255, 255); display: flex; justify-content: space-between; align-items: center; padding: 10px 40px; box-shadow: rgba(0, 0, 0, 0.05) 0px 1px 5px; }

.logo-img { height: 45px; width: auto; }

.nav-links { display: flex; gap: 30px; font-weight: 700; color: var(--text-grey); font-size: 15px; }

.nav-links a { text-decoration: none; color: inherit; transition: color 0.2s; }

.nav-links a:hover { color: var(--primary-color); }

.lang-switch { font-weight: bold; color: var(--text-grey); cursor: pointer; }

.breadcrumb { padding: 15px 40px; font-size: 13px; color: rgb(136, 136, 136); }

.breadcrumb span { margin: 0px 5px; color: rgb(187, 187, 187); }

.main-content { max-width: 650px; margin: 20px auto; text-align: center; padding: 0px 20px; }

h1 { font-size: 32px; color: var(--text-dark); margin-bottom: 10px; font-weight: 800; }

.subtitle { font-size: 16px; color: var(--text-grey); line-height: 1.6; margin-bottom: 40px; }

.search-card { background: rgb(255, 255, 255); border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.04) 0px 4px 20px; padding: 35px 30px; text-align: right; border: 1px solid rgb(238, 238, 238); margin-bottom: 50px; }

.search-card h2 { font-size: 20px; text-align: center; margin-top: 0px; margin-bottom: 30px; color: var(--text-dark); font-weight: 800; }

.form-group { margin-bottom: 25px; }

label { display: block; font-size: 14px; font-weight: 700; margin-bottom: 10px; color: rgb(68, 68, 68); }

input[type="text"] { width: 100%; padding: 15px; border: 1px solid rgb(204, 204, 204); border-radius: 6px; font-family: Tajawal, sans-serif; font-size: 15px; outline: none; background: rgb(253, 253, 253); }

input[type="text"]:focus { border-color: var(--green-color); box-shadow: rgba(23, 138, 72, 0.1) 0px 0px 0px 2px; }

.submit-btn { width: 100%; background-color: var(--green-color); color: rgb(255, 255, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 15px; border-radius: 6px; font-size: 18px; font-weight: 700; font-family: Tajawal; cursor: pointer; display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 15px; transition: background 0.3s; }

.submit-btn:hover { background-color: rgb(18, 112, 58); }

.alert-error { background-color: rgb(254, 226, 226); color: rgb(153, 27, 27); padding: 15px; border-radius: 6px; margin-bottom: 25px; font-size: 15px; text-align: center; }

.result-card { background: rgb(255, 255, 255); border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.06) 0px 4px 20px; padding: 30px; text-align: right; border-top: 5px solid var(--green-color); margin-bottom: 50px; }

.result-item { margin-bottom: 15px; border-bottom: 1px solid rgb(240, 240, 240); padding-bottom: 12px; }

.result-item:last-child { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.result-label { font-size: 13px; color: var(--text-grey); display: block; margin-bottom: 6px; }

.result-value { font-size: 16px; font-weight: 700; color: var(--text-dark); }

.btn-print { background: var(--primary-color); color: white; width: 100%; padding: 15px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 6px; font-family: Tajawal; font-size: 16px; font-weight: bold; margin-top: 20px; cursor: pointer; }

.footer { background-color: var(--bg-light); border-top: 1px solid rgb(221, 221, 221); padding: 50px 40px 20px; }

.footer-grid { display: flex; justify-content: center; gap: 50px; flex-wrap: wrap; text-align: center; margin-bottom: 40px; }

.footer-col { min-width: 250px; }

.footer-col h3 { font-size: 16px; color: var(--text-dark); margin-bottom: 20px; font-weight: 800; }

.footer-col p { font-size: 14px; color: var(--text-grey); line-height: 1.8; display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 10px; }

.icon-circle { display: inline-flex; justify-content: center; align-items: center; width: 38px; height: 38px; border: 1px solid rgb(204, 204, 204); border-radius: 6px; font-size: 18px; color: var(--text-grey); background: rgb(255, 255, 255); text-decoration: none; }

.social-wrap { display: flex; gap: 10px; justify-content: center; }

.footer-bottom { border-top: 1px solid rgb(204, 204, 204); padding-top: 25px; text-align: center; }

.footer-bottom p { color: var(--text-grey); font-size: 13px; margin: 5px 0px; }

.footer-links { margin: 15px 0px; }

.footer-links a { color: var(--text-grey); text-decoration: none; margin: 0px 15px; font-size: 14px; font-weight: bold; }

.logos-container { display: flex; justify-content: center; align-items: center; gap: 25px; margin-top: 30px; flex-wrap: wrap; }

.footer-logo-img { height: 35px; width: auto; max-width: 120px; object-fit: contain; }

.scroll-top { position: fixed; bottom: 30px; left: 30px; width: 40px; height: 40px; background: var(--green-color); color: white; border-radius: 50%; display: flex; justify-content: center; align-items: center; cursor: pointer; text-decoration: none; font-size: 20px; box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 10px; z-index: 99; }

@media screen and (max-width: 768px) {
  .header { padding: 15px 20px; }
  .nav-links, .lang-switch { display: none; }
  .footer-grid { flex-direction: column; gap: 30px; }
  .logos-container { gap: 15px; flex-direction: column; }
  .scroll-top { bottom: 15px; left: 15px; }
}
