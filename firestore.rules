rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{id} {
      // قراءة سجل واحد فقط (يتطلب معرفة الرقم والرمز معاً)، ولا يمكن سرد السجلات
      allow get: if true;
      allow list: if false;
      // الإنشاء والتعديل لموظفي المنشأة المسجلين فقط
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
